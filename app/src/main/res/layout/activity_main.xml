<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exercícios - Aula 09"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnEx3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Exercício 3: Reserva de Sala" />

    <Button
        android:id="@+id/btnEx4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Exercício 4: Tela de Login" />

    <Button
        android:id="@+id/btnEx5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Exercício 5: Inscrição em Evento" />

    <Button
        android:id="@+id/btnEx6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Exercício 6: Cadastro de Produto" />

    <Button
        android:id="@+id/btnEx7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exercício 7: Recuperar Senha" />

</LinearLayout>
